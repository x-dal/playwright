{
  "name": "playwright-automation-backend",
  "version": "1.0.0",
  "description": "REST API + Playwright executor for the automation framework",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "install:browsers": "npx playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@playwright/test": "^1.44.1",
    "archiver": "^6.0.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "playwright": "^1.44.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
